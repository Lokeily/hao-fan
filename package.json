{
  "name": "open-translator-cn",
  "version": "0.1.18",
  "description": "开源、免费、可自配置 API 的沉浸式 AI 翻译浏览器插件（国内模型优先）",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/core.test.mjs tests/translator-network.test.mjs",
    "test:browser": "playwright test",
    "check:version": "node scripts/check-version.mjs",
    "test:all": "npm run check:version && npm run lint && npm run test && npm run typecheck && npm run build && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write \"entrypoints/**/*.ts\" \"src/**/*.ts\" \"utils/**/*.ts\" \"tests/**/*.{ts,js,mjs,html}\" \"scripts/**/*.mjs\" \"*.config.{ts,js}\" \"styles/*.css\"",
    "perf": "playwright test perf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "wxt": "^0.20.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "esbuild": "0.28.2"
  }
}
